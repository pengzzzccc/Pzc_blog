# 复制为 /opt/pzc-blog/.env 并填写。deploy.yml 每次部署会自动更新 SITE_IMAGE 和 IMAGE_TAG。

# 镜像
SITE_IMAGE=ghcr.io/<github-user>/pzc-blog
IMAGE_TAG=latest

# 域名（Caddy 会自动申请 HTTPS 证书）
SITE_DOMAIN=example.com
ANALYTICS_DOMAIN=analytics.example.com

# Umami（用 `openssl rand -hex 32` 生成）
UMAMI_DB_PASSWORD=change-me
UMAMI_APP_SECRET=change-me

# 可选
# HTTP_PORT=80
# HTTPS_PORT=443
# GAMES_DIR=./games
