---
import BaseLayout from '../layouts/BaseLayout.astro';
import DevHint from '../components/DevHint.astro';
import Icon from '../components/Icon.astro';
import LibraryCover from '../components/LibraryCover.astro';
import WorkCover from '../components/WorkCover.astro';
import { profile } from '../data/profile';
import { localizePath, pick, t, withBase, type Lang } from '../i18n/utils';
import { getPosts, getWorks } from '../lib/content';
import { getLibrary, recentTime } from '../lib/library';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const works = await getWorks(lang);
const posts = await getPosts(lang);
const library = await getLibrary();
const playing = library.filter((e) => e.status === 'playing').sort((a, b) => recentTime(b) - recentTime(a));
const featured = works[0];
const name = pick(profile.name, lang);
const tagline = pick(profile.tagline, lang);
const location = pick(profile.location, lang);
const showAbout = profile.skills.length > 0 || profile.timeline.length > 0 || import.meta.env.DEV;

const linkClass =
  'rounded-md p-2 text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100';
const cardClass =
  'group flex flex-col box transition hover:-translate-y-0.5 hover:border-neutral-900 hover:shadow-lg dark:hover:border-neutral-300';
---

<BaseLayout lang={lang}>
  <!-- Hero：个人介绍 + 三个入口 -->
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <img src={withBase(profile.avatar)} alt={name} width="112" height="112" class="size-24 shrink-0 rounded-full ring-4 ring-white sm:size-28 dark:ring-neutral-800" />
      <div class="max-w-2xl flex-1">
        <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50">{name}</h1>
        {
          location && (
            <p class="mt-2 flex items-center gap-1 text-sm text-neutral-600 dark:text-neutral-400">
              <Icon name="pin" class="size-4" />
              {location}
            </p>
          )
        }
        {tagline ? <p class="mt-3 text-lg font-medium text-accent-600 dark:text-neutral-100">{tagline}</p> : <DevHint class="mt-3">在 src/data/profile.ts 的 tagline 写一句话定位</DevHint>}
        {
          profile.intro.length > 0 ? (
            <div class="mt-6 space-y-4 leading-relaxed text-neutral-700 dark:text-neutral-400">
              {profile.intro.map((p) => <p>{pick(p, lang)}</p>)}
            </div>
          ) : (
            <DevHint class="mt-4">在 src/data/profile.ts 的 intro 写自我介绍（每项一段，中英各一份）</DevHint>
          )
        }
        {
          profile.links.length > 0 || profile.resume ? (
            <div class="mt-6 flex flex-wrap items-center gap-1">
              {profile.links.map((link) => (
                <a href={link.url} aria-label={link.label} title={link.label} class={linkClass}>
                  <Icon name={link.icon} />
                </a>
              ))}
              {profile.resume && (
                <a href={withBase(profile.resume)} data-umami-event="download-resume" class="ml-2 inline-flex items-center gap-1.5 rounded-md border border-neutral-300 px-3 py-1.5 text-sm hover:border-neutral-900 hover:text-neutral-900 dark:border-neutral-700 dark:hover:text-neutral-100">
                  <Icon name="download" class="size-4" />
                  {t(lang, 'home.resume')}
                </a>
              )}
            </div>
          ) : (
            <DevHint class="mt-4">在 src/data/profile.ts 的 links 填写社交链接，resume 填写简历路径</DevHint>
          )
        }
      </div>
    </div>

    <h2 class="sr-only">{t(lang, 'home.entries')}</h2>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <!-- 作品集 -->
      <a href={localizePath('/games/', lang)} class:list={[cardClass, 'overflow-hidden']}>
        <div class="flex aspect-[16/7] items-center justify-center overflow-hidden bg-neutral-100 text-neutral-400 dark:bg-neutral-800 dark:text-neutral-600">
          {
            featured ? (
              <WorkCover work={featured} widths={[400, 640]} sizes="(min-width: 768px) 360px, 100vw" class="transition duration-300 group-hover:scale-105" />
            ) : (
              <Icon name="gamepad" class="size-12" />
            )
          }
        </div>
        <div class="flex flex-1 flex-col p-5">
          <div class="flex items-center gap-2 text-accent-600 dark:text-neutral-100">
            <Icon name="gamepad" />
            <span class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{t(lang, 'home.works.title')}</span>
            <Icon name="arrow" class="ml-auto size-5 transition group-hover:translate-x-1" />
          </div>
          <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-400">{t(lang, 'home.works.desc')}</p>
          <p class="mt-auto pt-4 text-xs text-neutral-600">
            {t(lang, 'home.works.count', { n: works.length })}
            {featured && <> · {featured.data.title}</>}
          </p>
        </div>
      </a>

      <!-- 博客 -->
      <a href={localizePath('/blog/', lang)} class:list={[cardClass, 'p-5']}>
        <div class="flex items-center gap-2 text-accent-600 dark:text-neutral-100">
          <Icon name="book" />
          <span class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{t(lang, 'home.blog.title')}</span>
          <Icon name="arrow" class="ml-auto size-5 transition group-hover:translate-x-1" />
        </div>
        <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-400">{t(lang, 'home.blog.desc')}</p>
        <ul class="mt-4 space-y-3 border-t border-neutral-100 pt-4 dark:border-neutral-800">
          {posts.length === 0 && <li class="text-sm text-neutral-500">{t(lang, 'blog.empty')}</li>}
          {
            posts.slice(0, 3).map((post) => (
              <li class="text-sm">
                <span class="line-clamp-1 font-medium text-neutral-900 dark:text-neutral-200">{post.data.title}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-auto pt-4 text-xs text-neutral-600">{t(lang, 'home.blog.count', { n: posts.length })}</p>
      </a>

      <!-- 游戏库 -->
      <a href={localizePath('/library/', lang)} class:list={[cardClass, 'p-5']}>
        <div class="flex items-center gap-2 text-accent-600 dark:text-neutral-100">
          <Icon name="library" />
          <span class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{t(lang, 'home.library.title')}</span>
          <Icon name="arrow" class="ml-auto size-5 transition group-hover:translate-x-1" />
        </div>
        <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-400">{t(lang, 'home.library.desc')}</p>
        <div class="mt-4 border-t border-neutral-100 pt-4 dark:border-neutral-800">
          {
            playing.length > 0 ? (
              <div class="grid grid-cols-4 gap-2">
                {playing.slice(0, 4).map((entry) => (
                  <div class="aspect-[2/3] overflow-hidden rounded-md bg-neutral-100 dark:bg-neutral-800" title={entry.title}>
                    <LibraryCover entry={entry} />
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-neutral-500">{t(lang, 'home.library.empty')}</p>
            )
          }
        </div>
        <p class="mt-auto pt-4 text-xs text-neutral-600">{t(lang, 'home.library.count', { n: playing.length })}</p>
      </a>
    </div>
  </section>

  <!-- 技能与经历 -->
  {
    showAbout && (
      <section>
        <div class="mx-auto grid max-w-6xl gap-4 px-4 pb-16 sm:px-6 md:grid-cols-2">
          <div class:list={['box p-6', !profile.skills.length && !import.meta.env.DEV && 'hidden']}>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">{t(lang, 'home.skills')}</h2>
            {profile.skills.length > 0 ? (
              <ul class="mt-6 flex flex-wrap gap-2">
                {profile.skills.map((skill) => (
                  <li class="rounded-lg border border-neutral-200 bg-neutral-100 px-3 py-1.5 text-sm dark:border-neutral-700 dark:bg-neutral-800">{pick(skill, lang)}</li>
                ))}
              </ul>
            ) : (
              <DevHint class="mt-6">在 src/data/profile.ts 的 skills 填写技能与引擎</DevHint>
            )}
          </div>
          <div class:list={['box p-6', !profile.timeline.length && !import.meta.env.DEV && 'hidden']}>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">{t(lang, 'home.timeline')}</h2>
            {profile.timeline.length > 0 ? (
              <ol class="mt-6 space-y-6 border-l border-neutral-200 pl-6 dark:border-neutral-700">
                {profile.timeline.map((item) => (
                  <li class="relative">
                    <span class="absolute -left-[29px] top-1.5 size-2.5 rounded-full bg-neutral-900 ring-4 ring-white dark:bg-neutral-100 dark:ring-neutral-900" />
                    <p class="text-xs font-medium text-accent-600 dark:text-neutral-100">{item.period}</p>
                    <p class="mt-1 font-semibold text-neutral-900 dark:text-neutral-100">{pick(item.title, lang)}</p>
                    <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-400">{pick(item.desc, lang)}</p>
                  </li>
                ))}
              </ol>
            ) : (
              <DevHint class="mt-6">在 src/data/profile.ts 的 timeline 填写经历（教育、项目、Game Jam、工作等）</DevHint>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
