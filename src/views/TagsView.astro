---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { localizePath, t, type Lang } from '../i18n/utils';
import { getPosts, getTags } from '../lib/content';

interface Props {
  lang: Lang;
  /** 不传时显示全部标签 */
  tag?: string;
}
const { lang, tag } = Astro.props;
const tags = await getTags(lang);
const posts = tag ? (await getPosts(lang)).filter((p) => p.data.tags.includes(tag)) : [];
const title = tag ? t(lang, 'tags.posts', { tag }) : t(lang, 'tags.title');
---

<BaseLayout lang={lang} title={title} alternate={tag ? null : undefined}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <SectionHeading as="h1" title={title}>
      {tag && <a href={localizePath('/tags/', lang)} class="mt-3 inline-block text-sm text-accent-600 hover:underline dark:text-neutral-100">← {t(lang, 'blog.allTags')}</a>}
    </SectionHeading>
    {
      tag ? (
        <div class="box divide-y divide-neutral-200 px-6 dark:divide-neutral-800">
          {posts.map((post) => <PostCard post={post} lang={lang} />)}
        </div>
      ) : (
        <ul class="flex flex-wrap gap-3">
          {[...tags].map(([name, count]) => (
            <li>
              <a href={localizePath(`/tags/${name}/`, lang)} class="inline-flex items-center gap-2 rounded-lg border border-neutral-300 bg-white px-3 py-2 dark:bg-neutral-900 hover:border-neutral-900 hover:text-neutral-900 dark:border-neutral-800 dark:hover:border-neutral-300 dark:hover:text-neutral-100">
                #{name}
                <span class="text-sm text-neutral-500">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
