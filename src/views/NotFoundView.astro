---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, '404.title')} alternate={localizePath('/404', lang === 'zh' ? 'en' : 'zh')}>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <p class="text-6xl font-bold text-accent-600 dark:text-neutral-100">404</p>
    <h1 class="mt-4 text-2xl font-bold text-neutral-900 dark:text-neutral-50">{t(lang, '404.title')}</h1>
    <p class="mt-3 text-neutral-700 dark:text-neutral-400">{t(lang, '404.desc')}</p>
    <a href={localizePath('/', lang)} class="mt-8 rounded-lg bg-accent-600 px-5 py-2.5 font-medium text-white hover:bg-accent-500">{t(lang, '404.home')}</a>
  </div>
</BaseLayout>
