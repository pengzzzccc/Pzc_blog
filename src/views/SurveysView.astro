---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { localizePath, pick, t, type Lang } from '../i18n/utils';
import { getSurveys } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const surveys = await getSurveys();

const filters = [
  { key: 'all', label: t(lang, 'surveys.filter.all') },
  { key: 'active', label: t(lang, 'surveys.filter.active') },
  { key: 'archived', label: t(lang, 'surveys.filter.archived') },
];

const countQuestions = (sections: { questions: unknown[] }[]) =>
  sections.reduce((sum, s) => sum + s.questions.length, 0);
---

<BaseLayout lang={lang} title={t(lang, 'surveys.title')} description={t(lang, 'surveys.desc')}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <SectionHeading as="h1" title={t(lang, 'surveys.title')} description={t(lang, 'surveys.desc')} />

    <div data-survey-filter class:list={['mb-8 flex flex-wrap gap-2', surveys.length === 0 && 'hidden']} role="group">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-neutral-300 bg-white px-3.5 py-1.5 text-sm text-neutral-700 hover:border-neutral-900 aria-pressed:border-accent-600 aria-pressed:bg-accent-600 aria-pressed:text-white dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:aria-pressed:border-neutral-100 dark:aria-pressed:bg-neutral-100 dark:aria-pressed:text-neutral-900"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div data-survey-grid class="grid gap-6 md:grid-cols-2">
      {
        surveys.map((survey) => {
          const questionCount = countQuestions(survey.data.sections);
          return (
            <a
              href={localizePath(`/surveys/${survey.id}/`, lang)}
              data-status={survey.data.status}
              class="group box flex flex-col justify-between p-6 transition hover:-translate-y-0.5 hover:border-neutral-900 hover:shadow-lg dark:hover:border-neutral-400"
            >
              <h2 class="text-xl font-bold text-neutral-900 group-hover:text-accent-600 dark:text-neutral-50 dark:group-hover:text-neutral-100">
                {pick(survey.data.title, lang)}
              </h2>
              <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-neutral-600 dark:text-neutral-400">
                <span>{t(lang, 'surveys.questionsCount', { n: questionCount })}</span>
                <span>·</span>
                <span>{t(lang, 'surveys.minutes', { n: survey.data.estimatedMinutes })}</span>
              </div>
            </a>
          );
        })
      }
    </div>

    <p data-survey-empty class:list={['mt-8 text-neutral-600 dark:text-neutral-400', surveys.length > 0 && 'hidden']}>
      {t(lang, 'surveys.empty')}
    </p>
  </div>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-survey-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-survey-grid] > a');
  const empty = document.querySelector<HTMLElement>('[data-survey-empty]');
  bar?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!button) return;
    for (const b of bar.querySelectorAll('[data-filter]')) b.setAttribute('aria-pressed', String(b === button));
    const key = button.dataset.filter ?? 'all';
    let shown = 0;
    for (const card of cards) {
      const visible = key === 'all' || card.dataset.status === key;
      card.toggleAttribute('data-filter-hidden', !visible);
      if (visible) shown++;
    }
    empty?.classList.toggle('hidden', shown > 0);
  });
</script>
