---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { localizePath, pick, t, type Lang } from '../i18n/utils';
import { getSurveys } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const surveys = await getSurveys();

const filters = [
  { key: 'all', label: t(lang, 'surveys.filter.all') },
  { key: 'active', label: t(lang, 'surveys.filter.active') },
  { key: 'archived', label: t(lang, 'surveys.filter.archived') },
];

const countQuestions = (sections: { questions: unknown[] }[]) =>
  sections.reduce((sum, s) => sum + s.questions.length, 0);
---

<BaseLayout lang={lang} title={t(lang, 'surveys.title')} description={t(lang, 'surveys.desc')}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <SectionHeading as="h1" title={t(lang, 'surveys.title')} description={t(lang, 'surveys.desc')} />

    <div data-survey-filter class:list={['mb-8 flex flex-wrap gap-2', surveys.length === 0 && 'hidden']} role="group">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-neutral-300 bg-white px-3.5 py-1.5 text-sm text-neutral-700 hover:border-neutral-900 aria-pressed:border-accent-600 aria-pressed:bg-accent-600 aria-pressed:text-white dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:aria-pressed:border-neutral-100 dark:aria-pressed:bg-neutral-100 dark:aria-pressed:text-neutral-900"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div data-survey-grid class="grid gap-6 md:grid-cols-2">
      {
        surveys.map((survey) => {
          const questionCount = countQuestions(survey.data.sections);
          const locked = Boolean(survey.data.accessGate?.enabled);
          return (
            <article
              data-status={survey.data.status}
              class="box flex flex-col justify-between p-6 transition hover:border-neutral-900 hover:shadow-lg dark:hover:border-neutral-400"
            >
              <div>
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="rounded-md bg-neutral-100 px-2 py-0.5 font-medium text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
                    {pick(survey.data.category, lang)}
                  </span>
                  <span class="rounded-md bg-accent-100 px-2 py-0.5 font-medium text-accent-800 dark:bg-neutral-800 dark:text-neutral-100">
                    {t(lang, `surveys.status.${survey.data.status}`)}
                  </span>
                  {locked && (
                    <span class="inline-flex items-center gap-1 rounded-md border border-neutral-300 px-2 py-0.5 text-neutral-700 dark:border-neutral-700 dark:text-neutral-300">
                      <Icon name="lock" class="size-3.5" />
                      {t(lang, 'surveys.keyRequired')}
                    </span>
                  )}
                </div>

                <h2 class="mt-3 text-xl font-bold text-neutral-900 dark:text-neutral-50">
                  {pick(survey.data.title, lang)}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-neutral-700 dark:text-neutral-400">
                  {pick(survey.data.summary, lang)}
                </p>

                <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-neutral-600 dark:text-neutral-400">
                  <span>{t(lang, 'surveys.questionsCount', { n: questionCount })}</span>
                  <span>·</span>
                  <span>{t(lang, 'surveys.minutes', { n: survey.data.estimatedMinutes })}</span>
                </div>
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-neutral-100 pt-4 dark:border-neutral-800">
                <a
                  href={localizePath(`/surveys/${survey.id}/`, lang)}
                  class="inline-flex items-center gap-1.5 rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
                >
                  {locked && <Icon name="lock" class="size-4" />}
                  {t(lang, 'surveys.open')}
                  <Icon name="arrow" class="size-4" />
                </a>

                {survey.data.relatedWork && (
                  <a
                    href={localizePath(`/games/${survey.data.relatedWork}/`, lang)}
                    class="inline-flex items-center gap-1 rounded-lg border border-neutral-300 px-3 py-2 text-sm text-neutral-700 transition hover:border-neutral-900 hover:text-neutral-900 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-400 dark:hover:text-neutral-100"
                  >
                    {t(lang, 'surveys.relatedWork')}
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    <p data-survey-empty class:list={['mt-8 text-neutral-600 dark:text-neutral-400', surveys.length > 0 && 'hidden']}>
      {t(lang, 'surveys.empty')}
    </p>
  </div>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-survey-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-survey-grid] > article');
  const empty = document.querySelector<HTMLElement>('[data-survey-empty]');
  bar?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!button) return;
    for (const b of bar.querySelectorAll('[data-filter]')) b.setAttribute('aria-pressed', String(b === button));
    const key = button.dataset.filter ?? 'all';
    let shown = 0;
    for (const card of cards) {
      const visible = key === 'all' || card.dataset.status === key;
      card.toggleAttribute('data-filter-hidden', !visible);
      if (visible) shown++;
    }
    empty?.classList.toggle('hidden', shown > 0);
  });
</script>
