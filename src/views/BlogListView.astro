---
import BaseLayout from '../layouts/BaseLayout.astro';
import DevHint from '../components/DevHint.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { localizePath, t, type Lang } from '../i18n/utils';
import { getPosts, getTags } from '../lib/content';

interface Props {
  lang: Lang;
  page: number;
}
const { lang, page } = Astro.props;
const posts = await getPosts(lang);
const tags = await getTags(lang);
const totalPages = Math.max(1, Math.ceil(posts.length / site.postsPerPage));
const shown = posts.slice((page - 1) * site.postsPerPage, page * site.postsPerPage);
const pageHref = (n: number) => localizePath(n === 1 ? '/blog/' : `/blog/page/${n}/`, lang);
---

<BaseLayout lang={lang} title={page > 1 ? `${t(lang, 'blog.title')} · ${t(lang, 'blog.page', { n: page })}` : t(lang, 'blog.title')} description={t(lang, 'blog.desc')}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <SectionHeading as="h1" title={t(lang, 'blog.title')} description={t(lang, 'blog.desc')} />
    <div class="grid gap-12 lg:grid-cols-[1fr_220px]">
      <div class="box divide-y divide-neutral-200 px-6 dark:divide-neutral-800">
        {
          shown.length === 0 && (
            <div class="space-y-3 py-6">
              <p class="text-neutral-600">{t(lang, 'blog.empty')}</p>
              <DevHint>运行 pnpm new:post &lt;slug&gt; "标题" 新建文章（加 --en 写英文版）</DevHint>
            </div>
          )
        }
        {shown.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
      <aside class:list={['order-first lg:order-none', tags.size === 0 && 'hidden']}>
        <h2 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">{t(lang, 'tags.title')}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            [...tags].map(([tag, count]) => (
              <li>
                <a href={localizePath(`/tags/${tag}/`, lang)} class="inline-flex items-center gap-1 rounded-md border border-neutral-300 bg-white px-2 py-1 text-xs text-neutral-700 hover:bg-accent-100 hover:text-neutral-900 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-accent-900/40 dark:hover:text-neutral-100">
                  #{tag}
                  <span class="text-neutral-500">{count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    {
      totalPages > 1 && (
        <nav class="mt-10 flex items-center justify-between border-t border-neutral-200 pt-6 text-sm dark:border-neutral-800" aria-label="Pagination">
          {page > 1 ? <a href={pageHref(page - 1)} class="text-accent-600 hover:underline dark:text-neutral-100">← {t(lang, 'blog.newer')}</a> : <span />}
          <span class="text-neutral-600">{page} / {totalPages}</span>
          {page < totalPages ? <a href={pageHref(page + 1)} class="text-accent-600 hover:underline dark:text-neutral-100">{t(lang, 'blog.older')} →</a> : <span />}
        </nav>
      )
    }
  </div>
</BaseLayout>
