---
// 作品封面：有 cover 用图片，没有时显示作品名标题占位
import { Image } from 'astro:assets';
import type { Work } from '../lib/content';

interface Props {
  work: Work;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  /** 标题占位的字号 */
  textClass?: string;
  class?: string;
}
const {
  work,
  widths = [400, 640, 800],
  sizes = '100vw',
  loading = 'lazy',
  textClass = 'text-2xl',
  class: className = '',
} = Astro.props;
const { cover, title } = work.data;
---

{
  cover ? (
    <Image src={cover} alt="" widths={widths} sizes={sizes} loading={loading} class:list={['size-full object-cover', className]} />
  ) : (
    <div class:list={['flex size-full items-center justify-center bg-neutral-900 bg-[url(/textures/paper.svg)] dark:bg-neutral-800 bg-size-[480px_480px] p-4 text-center', className]} aria-hidden="true">
      <span class:list={['font-bold tracking-wide text-white', textClass]}>{title}</span>
    </div>
  )
}
