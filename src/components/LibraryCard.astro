---
import LibraryCover from './LibraryCover.astro';
import StatusBadge from './StatusBadge.astro';
import { pick, t, type Lang } from '../i18n/utils';
import { recentTime, type LibraryEntry } from '../lib/library';

interface Props {
  entry: LibraryEntry;
  lang: Lang;
  reviewHref?: string;
}
const { entry, lang, reviewHref } = Astro.props;
const hours = entry.playtimeMinutes ? Math.round(entry.playtimeMinutes / 60) : 0;
---

<li
  data-status={entry.status}
  data-rating={entry.rating ?? 0}
  data-recent={recentTime(entry)}
  data-title={entry.title}
  class="box flex flex-col overflow-hidden"
>
  <div class="relative aspect-[2/3] overflow-hidden bg-neutral-100 dark:bg-neutral-800">
    <LibraryCover entry={entry} />
    <div class="absolute left-2 top-2"><StatusBadge status={entry.status} lang={lang} /></div>
    {
      entry.rating !== undefined && (
        <span class="absolute right-2 top-2 rounded-md bg-black/80 px-1.5 py-0.5 text-xs font-semibold text-white">★ {entry.rating}</span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1 p-3">
    <h3 class="line-clamp-1 text-sm font-semibold text-neutral-900 dark:text-neutral-100" title={entry.title}>{entry.title}</h3>
    <p class="text-xs text-neutral-600">
      {entry.platform}
      {hours > 0 && <> · {t(lang, 'library.hours', { n: hours })}</>}
    </p>
    {entry.comment && <p class="line-clamp-2 text-xs text-neutral-700 dark:text-neutral-400" title={pick(entry.comment, lang)}>{pick(entry.comment, lang)}</p>}
    {
      reviewHref && (
        <a href={reviewHref} data-umami-event="open-review" data-umami-event-slug={entry.slug} class="mt-auto pt-1 text-xs font-medium text-accent-600 hover:underline dark:text-neutral-100">
          {t(lang, 'library.review')} →
        </a>
      )
    }
  </div>
</li>
