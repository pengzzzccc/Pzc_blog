---
import WorkCover from './WorkCover.astro';
import { t, localizePath, type Lang } from '../i18n/utils';
import { slugOf, type Work } from '../lib/content';

interface Props {
  work: Work;
  lang: Lang;
}
const { work, lang } = Astro.props;
const { title, summary, engine, status, play } = work.data;
const playable = play.type === 'webgl';
---

<a
  href={localizePath(`/games/${slugOf(work)}/`, lang)}
  data-engine={engine}
  data-status={status}
  data-playable={String(playable)}
  class="group flex flex-col overflow-hidden box transition hover:-translate-y-0.5 hover:border-neutral-900 hover:shadow-lg dark:hover:border-neutral-300"
>
  <div class="relative aspect-video overflow-hidden bg-neutral-100 dark:bg-neutral-800">
    <WorkCover work={work} sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw" class="transition duration-300 group-hover:scale-105" />
    {
      playable && (
        <span class="absolute right-2 top-2 rounded-md bg-accent-600 px-2 py-0.5 text-xs font-medium text-white">
          {t(lang, 'works.playable')}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400">
      <span>{t(lang, `engine.${engine}`)}</span>
      <span aria-hidden="true">·</span>
      <span>{t(lang, `status.${status}`)}</span>
    </div>
    <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-accent-600 dark:text-neutral-100 dark:group-hover:text-neutral-100">{title}</h3>
    <p class="line-clamp-2 text-sm text-neutral-700 dark:text-neutral-400">{summary}</p>
  </div>
</a>
