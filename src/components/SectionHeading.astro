---
interface Props {
  title: string;
  description?: string;
  as?: 'h1' | 'h2';
}
const { title, description, as: Tag = 'h2' } = Astro.props;
---

<div class="mb-8">
  <Tag class:list={['font-bold tracking-tight text-neutral-900 dark:text-neutral-50', Tag === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
    {title}
  </Tag>
  {description && <p class="mt-3 max-w-2xl text-neutral-700 dark:text-neutral-400">{description}</p>}
  <slot />
</div>
